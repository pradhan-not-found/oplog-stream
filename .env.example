# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Database and collection names
DB_NAME=event_streaming
COLLECTION_NAME=sensor_events

# Session configuration
SESSION_ID=1          # Override per session (1-20)
PUSH_INTERVAL=0.5     # Seconds between each push (0 = as fast as possible)
TOTAL_RECORDS=1000    # Total documents each session will push

# Pull configuration
PULL_BATCH_SIZE=100
PULL_INTERVAL=1.0     # Seconds between each poll cycle
